rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per game, keyed by its five-character code.
    // Anyone with the code can read and write it; nothing else is reachable.
    match /games/{code} {
      function validCode() { return code.matches('^[A-Z0-9]{5}$'); }
      function validGame() {
        return request.resource.data.phase in ['lobby', 'mgmt', 'absorb', 'steward', 'org', 'over']
          && request.resource.data.expires is timestamp
          && request.resource.data.expires > request.time
          && request.resource.data.expires < request.time + duration.value(8, 'd');
      }
      allow get: if validCode();
      allow list: if false;
      allow create, update: if validCode() && validGame();
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
