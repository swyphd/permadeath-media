{
  "redirects": [
    { "source": "/guild-rising", "destination": "/guild-rising/", "permanent": true },
    { "source": "/union-up", "destination": "/union-up/", "permanent": true },
    { "source": "/homies", "destination": "/homies/", "permanent": true },
    { "source": "/stats", "destination": "/stats/", "permanent": true },
    { "source": "/marketing", "destination": "/marketing/", "permanent": true },
    { "source": "/press", "destination": "/press/", "permanent": true },
    { "source": "/devlog", "destination": "/devlog/", "permanent": true },
    { "source": "/devlog/:slug([a-z0-9-]+)", "destination": "/devlog/:slug/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/guild-rising/(.*)", "destination": "https://guild-rising.vercel.app/$1" },
    { "source": "/union-up/(.*)", "destination": "https://union-up.vercel.app/$1" }
  ]
}
